/* Configuración del panel administrativo Balansoft (BALASOFT-UI).
 * El panel habla contra la API del SERVIDOR (APP_ROLE=server).
 * La URL base es SIEMPRE relativa al dominio actual: /api/v1
 * (no se permite cambiarla desde el navegador por seguridad).
 */
(function () {
  var API_BASE = '/api/v1';

  window.BalansoftConfig = {
    DEFAULT_API_BASE: API_BASE,
    get apiBase() {
      return API_BASE;
    },
  };
})();
