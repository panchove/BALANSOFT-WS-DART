{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "engineer",
    "subagent_depth": 1,
    "permission": {
        "task": {
            "*": "deny",
            "planner": "allow",
            "implementer": "allow",
            "verifier": "allow",
            "engineer": "allow"
        }
    },
    "mcp": {
        "balansoft-filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/home/yohander/Documentos/BALANSOFT-WS-DART"
            ],
            "enabled": true,
            "timeout": 15000
        },
        "balansoft-git": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-git",
                "--repository",
                "/home/yohander/Documentos/BALANSOFT-WS-DART"
            ],
            "enabled": true,
            "timeout": 15000
        }
    }
}