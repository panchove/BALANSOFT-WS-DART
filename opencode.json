{
  "$schema": "https://opencode.ai/schema/opencode.json",
  "name": "BALANSOFT-WS",
  "description": "Sistema de pesaje industrial multi-empresa: FastAPI + Flutter + WServer runtime + HAL básculas",
  "version": "0.4.2-dev.56",
  "language": "es",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/bls-ws-iso-iec-compliance.md",
    ".opencode/rules/bls-ws-industrial-weighing-safety.md",
    ".opencode/rules/bls-ws-hardware-io-concurrency.md",
    ".opencode/rules/bls-ws-ticket-layout-parity.md"
  ],
  "mcpServers": {
    "balansoft-hardware": {
      "command": "python3",
      "args": ["src/backend/scripts/mcp_hardware_server.py"],
      "env": {
        "PYTHONPATH": "src/backend"
      }
    }
  },
  "scripts": {
    "backend:test": "cd src/backend && uv run pytest -q -m 'not e2e'",
    "backend:test-e2e": "cd src/backend && uv run pytest tests/e2e -q",
    "backend:lint": "cd src/backend && uv run ruff check app tests",
    "backend:typecheck": "cd src/backend && uv run mypy tests/",
    "backend:dev": "cd src/backend && uv run uvicorn app.main:app --port 8000 --reload",
    "backend:mcp": "cd src/backend && uv run python scripts/mcp_hardware_server.py",
    "frontend:analyze": "cd src/frontend && flutter analyze",
    "frontend:test": "cd src/frontend && flutter test",
    "frontend:e2e-ui": "cd src/frontend && flutter test integration_test/pesaje_flow_test.dart -d linux",
    "db:verify": "cd src/backend && ./scripts/verify.sh",
    "db:reset": "cd src/backend && ./scripts/reset_db.sh"
  },
  "domain": {
    "weighing": {
      "indicators": ["Yaohua XK3190", "Toledo/GSI", "Rice Lake", "Torrey", "Keli", "Cardinal", "MT-SICS"],
      "protocols": ["Serial RS232", "TCP", "Bluetooth SPP/BLE"],
      "states": ["PENDIENTE", "CERRADO", "MODIFICADO", "ANULADO"],
      "kardex": {
        "ingreso": 10,
        "despacho": 60
      }
    },
    "printers": {
      "thermal": ["POS_80 (80mm)", "POS_58 (58mm)"],
      "dot_matrix": ["EPSON LX-350", "EPSON FX-890", "OKI Microline"],
      "pdf": ["Media Carta", "Carta", "A4"]
    },
    "standards": {
      "quality": "ISO/IEC 25010 (SQuaRE)",
      "metrology": "ISO/IEC 17025 / OIML R 76-1 / WELMEC",
      "security": "ISO/IEC 27001",
      "testing": "ISO/IEC/IEEE 29119",
      "timestamps": "ISO 8601 (UTC)",
      "encoding": "ISO/IEC 10646 (UTF-8) / ISO/IEC 8859-1 (Latin-1)",
      "qr_code": "ISO/IEC 18004",
      "barcode_128": "ISO/IEC 15417"
    }
  }
}