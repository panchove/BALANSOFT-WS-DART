# ============================================
# BALANSOFT-WS - PLANTILLA DE PRODUCCIÓN
# Copiar a .env y completar los valores reales.
# NO subir .env a git ni exponer SECRET_KEY.
# ============================================

# --- Entorno (production para servidor real) ---
APP_ENV=production
DEBUG_MODE=false
API_DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=/var/log/balansoft-ws/app.log

# --- Conexión a Base de Datos de negocio (separada del LM) ---
# Usuario con permisos para la BD "balansoft_ws" en el servidor PostgreSQL remoto.
DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@localhost:5432/balansoft_ws
DATABASE_URL_SYNC=postgresql+psycopg2://USUARIO:PASSWORD@localhost:5432/balansoft_ws

# --- Arquitectura de dos BDs (docs/MANEJO_DB.md) ---
# APP_ROLE determina qué API se monta:
#   local  -> API operativa de la estación (boletos, catálogos, login-local offline)
#   server -> API central de cuenta y licencia (registro, credenciales, licencias, panel, sync)
# En rol "server": DATABASE_URL debe apuntar a la BD del servidor (balansoft_ws_server).
APP_ROLE=local
# URL base del servidor central (solo la usa el rol "local" para validar/registrar).
SERVER_API_URL=http://localhost:8002
# DB del servidor (opcional). Si se omite se usa DATABASE_URL (rol server).
SERVER_DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@localhost:5432/balansoft_ws_server

# --- LM Local (License Manager SGLB) - debe estar desplegado y accesible ---
# La creación de pesajes VALIDA la licencia online contra este URL (503 si no responde).
# URL pública del LM API (exposición vía nginx: lm.balansoft.com.ve/api/v1 -> 9001).
# En el servidor central con el LM local se usa http://127.0.0.1:9001/api/v1.
LICENSE_API_URL=https://lm.balansoft.com.ve/api/v1
LICENSE_ADMIN_URL=http://127.0.0.1:9000
# Clave pública Ed25519 del LM (anti-fake-server). Vía recomendada en servidores:
# archivo PEM en keys/lm_public_key.pem (relativo al backend; carpeta gitignored).
# Alternativa: LICENSE_PUBLIC_KEY con el PEM en una sola línea.
LICENSE_PUBLIC_KEY_PATH=keys/lm_public_key.pem
# LICENSE_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----'
LICENSE_PRODUCT_CODE=WS

# --- API de Balansoft-WS ---
# En el servidor escucha en 0.0.0.0 (estaciones desktop por LAN); restringir :8002 en el firewall.
API_HOST=0.0.0.0
API_PORT=8002
API_RELOAD=false
API_WORKERS=4

# --- Seguridad interna (JWT de la app). Generar con: openssl rand -hex 32 ---
SECRET_KEY=CAMBIAR_ESTA_CLAVE_CON_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: orígenes del frontend desplegado (Flutter Web) ---
CORS_ORIGINS=["https://app.balansoft.example.com","https://balansoft.example.com"]

# --- Sincronización ---
SYNC_INTERVAL_MINUTES=2
MAX_OFFLINE_DAYS=30
MAX_SYNC_RETRIES=3

# --- Límites de licencia ---
DEMO_MAX_RECORDS=10
MONOPUESTA_MAX_USERS=1
CENTRAL_MAX_USERS=10

# --- Recuperación de contraseña ---
# Minutos de validez del token y URL base a la que se anexa ?token=XXX
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_URL_BASE=https://app.balansoft.example.com/reset-password
# SMTP opcional. SMTP_ENABLED=false => el enlace se registra en el log del servidor
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@balansoft.example.com

# --- Rate-limiting (implementación propia, sin Redis) ---
# Habilitar en producción para limitar intentos de login/registro.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5        # máximo de intentos de login por ventana
RATE_LIMIT_REGISTER=3     # máximo de registros por ventana
RATE_LIMIT_PASSWORD=5     # máximo de forgot/reset-password por ventana
RATE_LIMIT_WINDOW=60      # ventana en segundos
RATE_LIMIT_TRUST_PROXY=false  # true si el servidor está detrás de nginx/proxy

# --- Monitoreo (prometheus-client) ---
METRICS_ENABLED=true

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30