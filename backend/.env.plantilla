# ============================================================
# BALANSOFT-WS - WServer: configuración de la estación (CLIENTE)
#
# Este archivo se genera AUTOMÁTICAMENTE en la primera ejecución
# del WServer a partir de esta plantilla (SECRET_KEY se reemplaza
# por una aleatoria por máquina). No se debe editar la plantilla
# en campo: edita el .env resultante.
# ============================================================

# --- Entorno (producción: kiosko, sin docs open) ---
APP_ENV=production
DEBUG_MODE=false
API_DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Rol: API operativa de la estación ---
APP_ROLE=local

# --- Servidor central de cuentas/licencias ---
# URL del panel central (ws.balansoft.com.ve). El backend local valida la
# cuenta y licencia contra este servidor (login-central) y sincroniza datos.
SERVER_API_URL=https://ws.balansoft.com.ve

# --- Conexión a la Base de Datos local (PostgreSQL de la máquina) ---
# Esta BD la crea y esquema el propio WServer al primer arranque.
DATABASE_URL=postgresql+asyncpg://balansoft:CHANGE_ME@localhost:5432/balansoft_ws_local
DATABASE_URL_SYNC=postgresql+psycopg2://balansoft:CHANGE_ME@localhost:5432/balansoft_ws_local

# --- LM del proveedor (validación online de pesajes) ---
# Lo ajusta el instalador/servidor central en la máquina del cliente.
# URL pública del LM API (exposición vía nginx: lm.balansoft.com.ve/api/v1 -> 9001).
# En el servidor central se usa http://127.0.0.1:9001/api/v1.
LICENSE_API_URL=https://lm.balansoft.com.ve/api/v1
LICENSE_ADMIN_URL=http://127.0.0.1:9000
LICENSE_PUBLIC_KEY_PATH=keys/lm_public_key.pem
LICENSE_PRODUCT_CODE=WS
# TTL (segundos) de la caché de validación de licencia en operación de pesaje
# (re-valida en vivo en login/panel). Default 300.
# LICENSE_CACHE_TTL_SECONDS=300

# --- API local (solo esta máquina; la app Flutter desktop la consume) ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_WORKERS=1

# --- Seguridad interna (JWT de la app). Se genera automáticamente. ---
SECRET_KEY=__SECRET_KEY__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: la app desktop no navega, pero se mantiene restringido ---
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Sincronización offline-first ---
SYNC_INTERVAL_MINUTES=2
MAX_OFFLINE_DAYS=30
MAX_SYNC_RETRIES=3

# --- Límites de licencia ---
DEMO_MAX_RECORDS=10
MONOPUESTA_MAX_USERS=1
CENTRAL_MAX_USERS=10

# --- Rate-limiting (desactivado en la estación local por defecto) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_WINDOW=60
RATE_LIMIT_TRUST_PROXY=false

# --- Monitoreo ---
METRICS_ENABLED=true

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30