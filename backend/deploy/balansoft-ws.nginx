# Template nginx para BALANSOFT-WS — ws.balansoft.com.ve
# Copiar como /etc/nginx/sites-available/balansoft-ws y enlazar a sites-enabled
# SOLO cuando el DNS y el certificado cubran ws.balansoft.com.ve
# (mismo patrón de seguridad que balansoft-sg.nginx).
#
# Certificado: el servidor usa un único Let's Encrypt por subdominos
# (/etc/letsencrypt/live/balansoft.com.ve). Antes de habilitar este sitio hay que
# ampliar su SAN para incluir ws.balansoft.com.ve:
#   sudo certbot --nginx -d balansoft.com.ve -d lm.balansoft.com.ve -d sg.balansoft.com.ve -d ws.balansoft.com.ve

# Redirección HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ws.balansoft.com.ve;
    return 301 https://$server_name$request_uri;
}

# Servidor HTTPS - SOLO API
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ws.balansoft.com.ve;

    ssl_certificate /etc/letsencrypt/live/balansoft.com.ve/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/balansoft.com.ve/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Fotos de pesaje (ImagenPesaje) subidas como base64: el tope por defecto
    # de Nginx (1 MB) causa HTTP 413. Igual criterio que SG (sync con fotos).
    client_max_body_size 20m;

    # Headers de seguridad (mismos que BALANSOFT-SG)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Todas las peticiones van a la API en puerto 8002
    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 60;
    }
}